# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://ai_pm_user:ai_pm_password@localhost:5433/ai_pm_tool
TEST_DATABASE_URL=postgresql+psycopg://ai_pm_user:ai_pm_password@localhost:5433/ai_pm_tool_test

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Claude / Anthropic (backend-only, never exposed to the browser)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5
# Required for identity-linked / org-scoped keys (Claude Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# CORS
FRONTEND_ORIGIN=http://localhost:3001

# Frontend (public — safe to expose to the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
